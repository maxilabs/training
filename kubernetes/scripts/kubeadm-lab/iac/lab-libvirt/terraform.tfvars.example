# Kopieer naar terraform.tfvars voor handmatig gebruik (terraform.tfvars staat in .gitignore).
# De workflow geeft ssh_public_key zelf mee met -var.
ssh_public_key = "ssh-ed25519 AAAA... jouw-key"

