# kubeadm-lab — centrale instellingen. Alle scripts lezen dit bestand.
# Pas hier aan, nergens anders.
# Uitleg (wat en waarom): SCRIPTS.md

# Dit bestand wordt door elk script ingelezen met 'source ./lab.env'.
# Daardoor zijn alle variabelen en functies hieronder in elk script beschikbaar.

# ── Kubernetes-versie ─────────────────────────────────────────────────────────
# pkgs.k8s.io heeft één apt-repo per minor-versie (v1.35, v1.36, ...).
# node-prep.sh gebruikt deze waarde in de repo-URL, dus dit bepaalt welke
# kubelet/kubeadm/kubectl er op de nodes komt. Altijd met een 'v' ervoor.
K8S_MINOR="v1.35"            # examenversie CKA; upgrade-oefening: v1.35 -> v1.36

# ── Netwerk ───────────────────────────────────────────────────────────────────
# POD_CIDR:     uit deze range krijgt elke Pod een IP. De CNI (Flannel/Calico/Cilium)
#               moet DEZELFDE range gebruiken als kubeadm, anders werkt Pod-verkeer niet.
# SERVICE_CIDR: uit deze range krijgt elke Service zijn ClusterIP (virtueel IP).
# Beide mogen niet overlappen met netwerken die je al hebt, anders stuurt de node
# verkeer de verkeerde kant op. Gecontroleerd: geen overlap met LAN 192.168.88.0/24,
# wlan 172.16.50.0/24, wg0 10.99.99.0/24 en libvirt 192.168.122.0/24.
POD_CIDR="172.30.0.0/16"
SERVICE_CIDR="172.31.0.0/16"
LIBVIRT_NET="default"        # het libvirt-netwerk (virbr0, NAT) waar de VM's aan hangen

# ── Nodes ─────────────────────────────────────────────────────────────────────
# Eén regel per VM: naam | IP | MAC | vCPU | RAM (MiB)
# create-vms.sh koppelt in libvirt de MAC aan het IP (DHCP-reservering).
# Zo krijgt elke VM altijd hetzelfde IP, ook na een reboot of snapshot-revert.
NODES=(
  "cp1 192.168.122.11 52:54:00:6b:00:11 2 4096"
  "w1  192.168.122.12 52:54:00:6b:00:12 2 4096"   # 4 GiB: ruimte voor monitoring (blok 7)
  "w2  192.168.122.13 52:54:00:6b:00:13 2 4096"
)
CP_NODE="cp1"                # de control-plane-node; de rest zijn workers

# Ander cluster inrichten met dezelfde scripts (scenario A, blok 8): zet LAB_ENV naar een bestand dat
# NODES en CP_NODE overschrijft, bijv. de uitvoer van 'terraform output -raw lab_env'.
#   LAB_ENV=/tmp/lab-tf.env ./prep-nodes.sh
# Zonder LAB_ENV verandert er niets.
if [ -n "${LAB_ENV:-}" ]; then
  [ -f "$LAB_ENV" ] || { echo "LAB_ENV wijst naar een niet-bestaand bestand: $LAB_ENV" >&2; exit 1; }
  source "$LAB_ENV"
fi
DISK_SIZE="20G"              # maximale disk per VM (qcow2 groeit pas als hij vol raakt)

# ── Add-ons (gebruikt door addons.sh) — versies geverifieerd 15-10-2026 ────────
# Vaste versies, zodat het lab morgen hetzelfde doet als vandaag.
METRICS_SERVER_URL="https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml"
LOCAL_PATH_VERSION="v0.0.36"
METALLB_VERSION="v0.16.1"
METALLB_RANGE="192.168.122.200-192.168.122.250"   # LoadBalancer-IP's; de 3 nodes hebben vaste IP's (.11-.13)
GATEWAY_API_VERSION="v1.6.1"
HELM_INSTALLER="https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-4"

# ── Argo CD (blok 7; gebruikt door argocd.sh) ─────────────────────────────────
# Vaste versie: de labs zijn hiertegen getest. Nieuwer? Dan kan een veld of poortnaam
# anders heten; check dan de release notes voordat je gaat zoeken in je YAML.
ARGOCD_VERSION="v3.5.6"
ARGOCD_NODEPORT_HTTPS="30443"   # https://<cp1-ip>:30443 is de UI (vanaf aristotle)
ARGOCD_NODEPORT_HTTP="30080"    # http -> https redirect van de UI
# De repo die Argo CD leest. Zelfde repo als deze training; het pad hieronder is de map
# met de manifests. Zet je dit in je eigen fork, pas dan ARGOCD_REPO_URL in de manifests aan
# (dat staat in git, dus dat is een gewone commit) en hier voor de raw-URL's in de docs.
ARGOCD_REPO_URL="https://github.com/maxilabs/training.git"
ARGOCD_REVISION="main"
ARGOCD_GITOPS_PATH="kubernetes/gitops-lab"
# SSO via de Dex-server die met Argo CD meekomt (één lokale gebruiker, geen externe IdP nodig).
ARGOCD_SSO_EMAIL="student@lab.local"
ARGOCD_SSO_PASSWORD="lab-wachtwoord"
# Image updater is optioneel (lab G-17). Nieuwere versie kan: check de release notes.
ARGOCD_IMAGE_UPDATER_VERSION="v1.4.0"

# ── Image (Ubuntu 24.04 LTS cloud image) ──────────────────────────────────────
# Een cloud image is een kant-en-klare disk zonder installer; cloud-init richt hem
# bij de eerste boot in. BASE_IMG wordt één keer gedownload; elke VM krijgt daar
# een eigen 'overlay'-disk bovenop (zie create-vms.sh).
IMG_URL_BASE="https://cloud-images.ubuntu.com/noble/current"
IMG_FILE="noble-server-cloudimg-amd64.img"
IMG_DIR="/var/lib/libvirt/images"
BASE_IMG="${IMG_DIR}/kubeadm-lab-base.img"

# ── Toegang ───────────────────────────────────────────────────────────────────
VM_USER="ubuntu"             # gebruiker die cloud-init aanmaakt, met jouw SSH-key
# SSH-opties voor de scripts:
#   accept-new          -> nieuwe hostkey automatisch accepteren (geen yes/no-vraag),
#                          een GEWIJZIGDE key blijft wel een fout (bescherming tegen MITM)
#   eigen known_hosts   -> VM-keys komen niet in je gewone ~/.ssh/known_hosts;
#                          destroy-vms.sh ruimt ze hier weer op
#   ConnectTimeout=5    -> niet eindeloos wachten als een VM nog opstart
SSH_OPTS=(-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="${HOME}/.ssh/kubeadm-lab_known_hosts" -o ConnectTimeout=5)
# qemu:///system = de systeem-libvirt (VM's van root/libvirt-groep), niet de per-gebruiker-sessie.
export LIBVIRT_DEFAULT_URI="qemu:///system"

# ── Hulpfuncties ──────────────────────────────────────────────────────────────
# node_field <naam> <kolom>  -> kolom uit de NODES-regel van die node (2=IP, 3=MAC, ...)
# node_names                 -> alle nodenamen, één per regel
# node_ip <naam>             -> het IP van die node
# vm_ssh <naam> <commando>   -> voert <commando> via SSH uit op die node
# log / die                  -> blauwe melding / rode foutmelding en stoppen
node_field() { local n="$1" f="$2"; for l in "${NODES[@]}"; do set -- $l; [ "$1" = "$n" ] && { eval "echo \${$f}"; return; }; done; }
node_names() { for l in "${NODES[@]}"; do set -- $l; echo "$1"; done; }
node_ip()    { node_field "$1" 2; }
vm_ssh()     { local n="$1"; shift; ssh "${SSH_OPTS[@]}" "${VM_USER}@$(node_ip "$n")" "$@"; }
log()        { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
die()        { printf '\033[1;31mFOUT:\033[0m %s\n' "$*" >&2; exit 1; }
